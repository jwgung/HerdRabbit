{
  "name": "herd-rabbit",
  "version": "1.2.71",
  "private": true,
  "type": "module",
  "description": "A personal PWA for controlling local and SSH-connected Herdr sessions",
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "install-service": "node scripts/install-service.mjs",
    "password": "node scripts/password.mjs",
    "update": "sh update.sh",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "check:ui": "node scripts/check-ui-library.mjs",
    "check:browser": "node scripts/run-browser-checks.mjs",
    "build:xterm": "node scripts/build-xterm.mjs",
    "check:xterm": "node scripts/build-xterm.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "marked": "^18.0.12",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "esbuild": "0.24.0",
    "playwright": "1.63.0",
    "typescript": "5.6.3"
  }
}
